{
  "name": "terminal-lab",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --config frontend/vite.config.js",
    "dev:frontend": "vite --config frontend/vite.config.js",
    "dev:backend": "node backend/server.js",
    "dev:all": "concurrently \"npm run dev:frontend\" \"npm run dev:backend\"",
    "build": "vite build --config frontend/vite.config.js",
    "preview": "vite preview --config frontend/vite.config.js",
    "start": "node backend/server.js"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.0.4",
    "concurrently": "^10.0.6",
    "vite": "^7.1.7"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  }
}
