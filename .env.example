# Copy this file to .env.local and paste the Firebase Web App config values.
# These values are public client configuration, but keep server credentials out
# of the repository. Enable Google provider and Firestore in Firebase Console.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
